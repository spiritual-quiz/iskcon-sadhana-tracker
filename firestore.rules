rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Daily Sadhana Cards
    match /sadhana_entries/{entryId} {
      allow read, write: if request.auth != null;
    }
    
    // Weekly Programme Attendance
    match /weekly_attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }
    
    // Monthly Satsanga Attendance
    match /monthly_satsanga/{satsangaId} {
      allow read, write: if request.auth != null;
    }
    
    // Shared Weekly Community Summaries
    match /shared_weekly_summaries/{summaryId} {
      allow read, write: if request.auth != null;
    }
    
    // Shared Monthly Community Summaries
    match /shared_monthly_summaries/{summaryId} {
      allow read, write: if request.auth != null;
    }
    
    // Invitation Codes (read allowed so new registrants can validate code)
    match /invitations/{invitationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Notifications & Reminders
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
  }
}
